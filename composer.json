{
    "name": "socialdept/atp-client",
    "description": "Type-safe AT Protocol HTTP client with OAuth 2.0 support for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "atproto",
        "bluesky",
        "at-protocol",
        "oauth",
        "xrpc",
        "laravel"
    ],
    "authors": [
        {
            "name": "SocialDept",
            "email": "hello@socialdept.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-fileinfo": "*",
        "firebase/php-jwt": "^7.0",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "phpseclib/phpseclib": "^3.0",
        "socialdept/atp-support": "^0.3",
        "socialdept/atp-schema": "^0.4"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "friendsofphp/php-cs-fixer": "^3.89",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "SocialDept\\AtpClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SocialDept\\AtpClient\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "format": "vendor/bin/php-cs-fixer fix"
    },
    "extra": {
        "laravel": {
            "providers": [
                "SocialDept\\AtpClient\\AtpClientServiceProvider"
            ],
            "aliases": {
                "Atp": "SocialDept\\AtpClient\\Facades\\Atp"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
